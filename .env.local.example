# --- Supabase (Project Settings -> API / Data API) -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- OpenAI (platform.openai.com -> API keys) -----------------------------
# Server-side only. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-...
# Optional: override the model used for insights (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# --- Optional -------------------------------------------------------------
# Timezone used to decide what "today" and "this week" mean.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Tashkent
