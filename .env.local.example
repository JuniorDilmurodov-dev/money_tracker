# --- Supabase (Project Settings -> API / Data API) -------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- OpenAI (platform.openai.com -> API keys) -----------------------------
# Server-side only. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-...
# Optional: override the model used for insights (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# --- Optional -------------------------------------------------------------
# Insights each account may generate per day. Every generation is billed to
# the OPENAI_API_KEY above, so this is what caps the bill once other people can
# sign up. Default 3. Set to 0 to switch insights off entirely.
# INSIGHTS_DAILY_LIMIT=3

# Timezone used to decide what "today" and "this week" mean.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Tashkent

# --- Push notifications (optional) -----------------------------------------
# Generate a pair with `npx web-push generate-vapid-keys`.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:you@example.com
#
# Server-only. Bypasses row level security — used exclusively by the daily
# reminder cron route to check every subscribed user's expenses, never by
# anything that takes user input. Never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=...
#
# Random string. Vercel Cron sends it as `Authorization: Bearer <value>`;
# the reminder route checks it so nobody else can trigger a mass-send.
# CRON_SECRET=...
